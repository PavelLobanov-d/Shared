<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Shared.Kernel</PackageId>
    <Version>1.0.0</Version>
    <Authors>PavelLobanov-d</Authors>
    <Company>PavelLobanov-d</Company>
    <Title>Shared.Kernel</Title>
    <Description>Shared kernel with errors, envelopes, endpoint results and statistics primitives.</Description>
    <PackageTags>shared;kernel;errors;results;aspnetcore</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>false</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CSharpFunctionalExtensions" />
    <PackageReference Include="FluentValidation" VersionOverride="12.1.1" />
  </ItemGroup>

</Project>
